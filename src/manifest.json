{
  "manifest_version": 3,
  "name": "LibSaver",
  "version": "1.7",
  "description": "Любимые тайтлы при белых списках.",
  "author": "DPG",
  "homepage_url": "https://github.com/dfy-dpg/LibSaver",
  "permissions": [
    "tabs",
    "storage",
    "scripting",
    "activeTab",
    "webRequest",
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess",
    "downloads",
    "system.display",
    "unlimitedStorage",
    "offscreen"
  ],

  "declarative_net_request": {
    "rule_resources": [{
      "id": "manga_headers",
      "enabled": true,
      "path": "rules.json"
    }]
  },
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://ranobelib.me/*", "https://*.ranobelib.me/*", "https://novelslib.me/*", "https://*.novelslib.me/*", "https://mangalib.me/*", "https://*.mangalib.me/*", "https://mangalib.org/*", "https://*.mangalib.org/*", "https://hentailib.me/*", "https://*.hentailib.me/*", "https://hentailib.org/*", "https://*.hentailib.org/*", "https://shlib.life/*", "https://*.shlib.life/*", "https://animelib.org/*", "https://*.animelib.org/*", "https://anilib.me/*", "https://*.anilib.me/*"],
      "js": ["content/SiteMenuRestorer.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://ranobelib.me/*", "https://*.ranobelib.me/*", "https://novelslib.me/*", "https://*.novelslib.me/*", "https://mangalib.me/*", "https://*.mangalib.me/*", "https://mangalib.org/*", "https://*.mangalib.org/*", "https://hentailib.me/*", "https://*.hentailib.me/*", "https://hentailib.org/*", "https://*.hentailib.org/*", "https://shlib.life/*", "https://*.shlib.life/*"],
      "js": ["core/theme.js", "utils/page-call.js", "content/site-ui.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "32": "assets/icons/icon32.png"
    },
    "default_popup": "html/popup.html",
    "default_title": "LibSaver - Скачивание тайтлов"
  },
  "web_accessible_resources": [
    {
      "resources": ["html/popup.html", "html/settings.html", "html/metadata.html", "html/chapters.html", "html/covers.html", "html/prepare.html", "html/downloads.html", "assets/local_data", "assets/svg/*.svg", "assets/fonts/*", "assets/gif/*", "css/site-ui.css", "html/workspace.html", "html/panel.html", "html/quick.html", "libs/fontawesome/webfonts/fa-solid-900.woff2"],
      "matches": ["<all_urls>"]
    }
  ]
}